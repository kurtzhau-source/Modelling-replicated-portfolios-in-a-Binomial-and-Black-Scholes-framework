#Now lets compute our self replicating portfolio
#we need to compute delta and B  




def bin_call_price_port(n,vol,S,k,r0,u,d):

# n : number of timesteps in time t 
# u : upwards weight
# d : downwards weight
# S : stock price 
# r : interest rate 


#call cost
    call_cost = 0

#discount the interest rate for the current time 
    
#using Cox's proposals calculate u and d based off of vol 

#check for no arbitrage constraints
    if 0 < d < r0 < u:
    #calculate probability weights 
        pi = (r0 - d)/(u-d)
#compute sum 
        for j in range(0,n+1): 
            call_cost  = call_cost + math.comb(n,j)*(pi**j)*((1-pi)**(n-j))*max(0,(u**j)*(d**(n-j))*S - k)

#final price of a bin option calculated 
        call_cost = (1/(r0**n))*call_cost 
        return(call_cost)
    else: 
        return("Arbitrage is possible")



def stock_amount(n,vol, S, k, r0,u,d):  
    sum = 0
   
    crash_prevent = (u -d) *S 
    if math.isclose(crash_prevent, 0) == True:
        return(0)
    sum = (((u-d)*S)**(-1)) * ( bin_call_price_port(n-1,vol,u*S,k,r0,u,d) - bin_call_price_port(n-1,vol,d*S,k,r0,u,d) ) 
    return(sum)

def amount_cash_bond(n,vol, S, k, r0,u,d): 
    total = 0 
    total = ((r0*(u-d))**(-1)) * ( u*bin_call_price_port(n-1,vol,d*S,k,r0,u,d) -  d*bin_call_price_port(n-1,vol,u*S,k,r0,u,d)) 
    return(total) 



#now we want to simulate binomial motion and simulate someone buying a call and you hedging it 

#initalise our constants
n = 50
K = 5
S=7
r0 = np.exp(0.06/n) 
vol = 0.5
u = cox_call_up(n,vol)
d = cox_call_down(n,vol)

#initalise our arrays 
stock_price_ot = np.array([S])
hedged_stock = np.array([])
bond_position = np.array([])
port_value = np.array([])
bin_call_value = np.array([]) 
value_difference = np.array([])


#port = stock_price_ot[i]*stock + bond


stock = stock_amount(n,0.5, stock_price_ot[0], K , r0,u,d) 
bond = amount_cash_bond(n,0.5, stock_price_ot[0], K , r0,u,d)


#compute the purchasing of stock and borrowing of cash bond 
for i in range(0,n):  

    #simulate bin walk by factor u and d 
    if random.uniform(0,1) <=  0.49 or stock_price_ot[i] == 0:
        stock_price_ot = np.append(stock_price_ot, stock_price_ot[i]*u ) 
    else: 
        stock_price_ot = np.append(stock_price_ot, stock_price_ot[i] *d )

    port_now = stock_price_ot[i+1]*stock + bond*r0

    #counting steps left
    steps_left = n - (i + 1)

    #check there are
    if steps_left > 0:
    # Option payoff boundary at expiration 
        current_call_val = bin_call_price_port(steps_left, vol, stock_price_ot[i+1], K, r0, u, d)
        stock = stock_amount(steps_left, vol, stock_price_ot[i+1], K, r0, u, d)
        bond = amount_cash_bond(steps_left, vol, stock_price_ot[i+1], K, r0, u, d)
        
    else:
        # Expiration payoff 
        current_call_val = max(0, stock_price_ot[i+1] - K)
        stock = 1.0 if stock_price_ot[i+1] > K else 0.0
        bond = -float(K) if stock_price_ot[i+1] > K else 0.0
    

    port_value = np.append(port_value, port_now) 
    hedged_stock = np.append( hedged_stock, stock )
    bond_position = np.append(bond_position, bond)
    bin_call_value = np.append(bin_call_value, current_call_val)
    value_difference = np.append(value_difference, current_call_val - port_now)

plt.plot(range(0,n +1 ),stock_price_ot , label = "blue") 
plt.plot(range(1,n +1),hedged_stock , color = "red") 
plt.plot(range(1,n +1),bond_position, color = "orange") 
plt.plot(range(1,n +1),port_value, color = "green") 
plt.legend(["Stock Price" , " Stock Position" ,  "Bond Position", "Portfolio Value"])
plt.show()

        

    #counting steps left
    BS_steps_left = 1 - i/(N)

    # If time to expiry is effectively zero, use intrinsic value
    if BS_steps_left <= 1e-9: # Use a small epsilon to catch near-zero time
        BS_call_val_at_i = max(0, BS_S[i] - K)

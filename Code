def bin_call_price(n,vol,S,k,r):

# n : number of timesteps in time t 
# u : upwards weight
# d : downwards weight
# S : stock price 
# r : interest rate 


#call cost
    call_cost = 0

#discount the interest rate for the current time 
    r0 = 1+ r/n  
#using Cox's proposals calculate u and d based off of vol 

    u = np.exp(vol*(np.sqrt(1/n)))
    d = np.exp(-1*vol*(np.sqrt(1/n)))

#check for no arbitrage constraints
    if 0 < d < r0 < u:
    #calculate probability weights 
        pi = (r0 - d)/(u-d)
#compute sum 
        for j in range(0,n+1): 
            call_cost  = call_cost + math.comb(n,j)*(pi**j)*((1-pi)**(n-j))*max(0,(u**j)*(d**(n-j))*S - k)

#final price of a bin option calculated 
        call_cost = (1/(r0**n))*call_cost 
        return(call_cost)
    else: 
        return("Arbitrage is possible")



print(bin_call_price(10,0.3,20,20, 0.06))


def black_scholes_call(S0, K, r, sigma, t):
    d1 = (np.log(S0/K) + (r + (sigma**2)/2)*t)/(sigma*np.sqrt(t))
    d2 = d1 - sigma*np.sqrt(t)
    
    call = S0*norm.cdf(d1) - K*np.exp(-t*r)*norm.cdf(d2)
 
    return call



